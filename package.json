{
	"name": "voima-flame-sparkle",
	"version": "1.0.0",
	"description": "Voima Lyhty - Modern static wellness website built with Astro",
	"author": "Nanna",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"check": "astro build && tsc --noEmit && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "astro dev",
		"preview": "astro build && WRANGLER_LOG_PATH=.wrangler/logs wrangler dev"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource/cormorant-garamond": "^5.2.11",
		"@fontsource/karla": "^5.2.8",
		"astro": "^6.4.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"wrangler": "^4.95.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"private": true
}
