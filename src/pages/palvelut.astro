---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/Reveal.astro";
import SessionCalendar from "../components/SessionCalendar.astro";
import { services, sessionEvents } from "../lib/site-data";
import { Image } from "astro:assets";
---

<BaseLayout
  title="Palvelut — Voima Lyhty | Äänimaljat, hieronta, terapia"
  description="Äänimaljarentoutus, sointukylpy, vyöhyketerapia, hermoratahieronta, rentouttava facelift ja voimavara-terapia Helsingin Pasilassa."
>
  <section class="ambient-section bg-ink pt-32 text-sand md:pt-40" style='--ambient-image: url("/atmosphere-inner.webp"); --ambient-opacity: 0.32' data-theme="dark">
    <div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/82 to-sand"></div>
    <div class="relative mx-auto max-w-6xl px-6 pb-20 text-center md:px-10">
      <Reveal>
        <span class="eyebrow text-sun">Palvelut</span>
      </Reveal>
      <Reveal delay={0.1}>
        <h1 class="display-lg mx-auto mt-6 max-w-4xl font-display italic text-sand">
          Kuusi tietä <span class="text-sun">syvempään lepoon.</span>
        </h1>
      </Reveal>
      <Reveal delay={0.2}>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-sand/76">
          Jokainen hoito on hidas matka kohti hermoston hiljentymistä. Valitse,
          mikä juuri nyt kutsuu — voit aina kysyä, jos olet epävarma.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="bg-sand pb-24 text-driftwood md:pb-32" data-theme="warm">
    <div class="mx-auto -mt-10 grid max-w-7xl gap-5 px-6 sm:grid-cols-2 md:px-10 lg:grid-cols-3" data-service-grid>
      {
        services.map((service, i) => (
          <Reveal delay={(i % 3) * 0.08}>
            <article class="group flex h-full flex-col overflow-hidden rounded-[1.5rem] bg-cream p-3 shadow-[0_1.5rem_4rem_oklch(0.176_0.026_58_/_0.08)] transition duration-500 hover:-translate-y-1.5" data-service-card={service.slug}>
              <a
                href={`/palvelut/${service.slug}`}
                class="media-frame aspect-[16/11] rounded-[1.15rem]"
              >
                <Image src={service.image} alt={service.name} width={1024} height={1024} loading="lazy" />
              </a>

              <div class="flex flex-1 flex-col p-5">
                <div class="flex items-center gap-3">
                  <span class="font-display text-base italic text-ember">{service.number}</span>
                  <span class="h-px flex-1 bg-driftwood/12"></span>
                  <span class="text-[0.65rem] font-semibold uppercase tracking-luxe text-driftwood/45" data-service-field="duration">{service.duration}</span>
                </div>
                <h2 class="mt-4 font-display text-3xl italic leading-tight text-driftwood" data-service-field="name">
                  {service.name}
                </h2>
                <p class="mt-2 font-display text-xl italic text-ember" data-service-field="tagline">{service.tagline}</p>
                <p class="mt-4 flex-1 text-sm leading-relaxed text-driftwood/68" data-service-field="short">{service.short}</p>
                <div class="mt-5 flex items-center justify-between gap-3">
                  <span class="font-display text-xl italic text-driftwood" data-service-field="price">{service.price}</span>
                  <a href={`/palvelut/${service.slug}`} class="btn-primary">Lue lisää</a>
                </div>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </section>

  <section class="bg-cream py-20 text-driftwood md:py-28" data-theme="warm">
    <div class="mx-auto max-w-7xl px-6 md:px-10">
      <Reveal>
        <SessionCalendar
          events={sessionEvents}
          title="Palveluiden yhteinen kalenteri"
          emptyMessage="Kalenteriin ei ole vielä lisätty sessioita."
        />
      </Reveal>
    </div>
  </section>
</BaseLayout>

<script>
  async function syncServicesOverview() {
    const root = document.querySelector<HTMLElement>("[data-service-grid]");
    if (!root) return;
    try {
      const response = await fetch("/api/content/public", { headers: { accept: "application/json" } });
      if (!response.ok) return;
      const payload = await response.json();
      if (!Array.isArray(payload?.services)) return;
      const serviceMap = new Map(payload.services.map((service: any) => [service.slug, service]));
      root.querySelectorAll<HTMLElement>("[data-service-card]").forEach((card) => {
        const slug = card.dataset.serviceCard;
        if (!slug) return;
        const service = serviceMap.get(slug);
        if (!service) return;
        card.querySelector<HTMLElement>('[data-service-field="name"]')?.replaceChildren(service.name);
        card.querySelector<HTMLElement>('[data-service-field="tagline"]')?.replaceChildren(service.tagline);
        card.querySelector<HTMLElement>('[data-service-field="short"]')?.replaceChildren(service.short);
        card.querySelector<HTMLElement>('[data-service-field="price"]')?.replaceChildren(service.price);
        card.querySelector<HTMLElement>('[data-service-field="duration"]')?.replaceChildren(service.duration);
      });
    } catch {
      // Keep static fallback content on any runtime fetch issue.
    }
  }

  syncServicesOverview();
  document.addEventListener("astro:after-swap", syncServicesOverview);
</script>
