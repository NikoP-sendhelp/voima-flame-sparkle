---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Reveal from "../../components/Reveal.astro";
import SessionCalendar from "../../components/SessionCalendar.astro";
import { services, sessionEvents } from "../../lib/site-data";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: (typeof services)[0];
}

const { service } = Astro.props;
const idx = services.findIndex((s) => s.slug === service.slug);
const next = services[(idx + 1) % services.length];
---

<BaseLayout
  title={`${service.name} — Voima Lyhty`}
  description={service.short}
  ogImage={service.image}
>
  <article>
    <section class="relative min-h-[62svh] overflow-hidden bg-ink pt-32 text-sand" data-theme="dark">
      <div class="absolute inset-0">
        <Image src={service.image} alt="" width={1024} height={1024} class="h-full w-full object-cover animate-slow-zoom" />
        <div class="absolute inset-0 bg-gradient-to-b from-ink/45 via-ink/50 to-ink/86"></div>
      </div>
      <div class="relative mx-auto flex min-h-[62svh] max-w-7xl flex-col justify-end px-6 pb-14 md:px-10">
        <Reveal>
          <span class="font-display text-4xl italic text-sun">{service.number}</span>
        </Reveal>
        <Reveal delay={0.1}>
          <h1 class="display-md mt-5 max-w-4xl font-display italic text-sand">{service.name}</h1>
        </Reveal>
        <Reveal delay={0.18}>
          <p class="mt-6 max-w-2xl font-display text-3xl italic leading-tight text-sun">{service.tagline}</p>
        </Reveal>
      </div>
    </section>

    <section class="bg-sand py-16 text-driftwood md:py-24" data-theme="warm">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 md:grid-cols-12 md:px-10">
        <div class="md:col-span-8">
          <Reveal>
            <div class="space-y-6 text-lg leading-relaxed text-driftwood/78">
              {service.body.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </Reveal>

          <Reveal delay={0.12}>
            <div class="mt-12 grid gap-4 sm:grid-cols-2">
              <div class="glass-panel rounded-[1.5rem] p-7">
                <div class="eyebrow text-driftwood/45">Kesto</div>
                <div class="mt-3 font-display text-4xl italic text-driftwood">{service.duration}</div>
              </div>
              <div class="glass-panel rounded-[1.5rem] p-7">
                <div class="eyebrow text-driftwood/45">Hinta</div>
                <div class="mt-3 font-display text-4xl italic text-driftwood">{service.price}</div>
              </div>
            </div>
          </Reveal>
        </div>

        <aside class="md:col-span-4">
          <div class="sticky top-28 space-y-6">
            <Reveal>
              <div class="rounded-[1.5rem] bg-ember p-7 text-sand shadow-[0_1.5rem_4rem_oklch(0.58_0.142_38_/_0.18)]">
                <h3 class="eyebrow text-sand/70">Varaa tämä hoito</h3>
                <p class="mt-4 font-display text-3xl italic leading-snug">{service.name}</p>
                <a href="/yhteys" class="btn-primary mt-7 w-full bg-sand text-ember hover:bg-ink hover:text-sand">
                  Ota yhteyttä
                </a>
              </div>
            </Reveal>

            <Reveal delay={0.12}>
              <a href={`/palvelut/${next.slug}`} class="group block rounded-[1.5rem] bg-cream p-3 shadow-sm">
                <div class="eyebrow px-3 pt-2 text-driftwood/45">Seuraava hoito</div>
                <div class="media-frame mt-3 aspect-[4/3] rounded-[1.15rem]">
                  <Image src={next.image} alt={next.name} width={1024} height={1024} loading="lazy" />
                </div>
                <h4 class="p-3 font-display text-2xl italic text-driftwood group-hover:text-ember">
                  {next.name}
                </h4>
              </a>
            </Reveal>
          </div>
        </aside>
      </div>
    </section>

    <section class="bg-cream py-16 text-driftwood md:py-24" data-theme="warm">
      <div class="mx-auto max-w-7xl px-6 md:px-10">
        <Reveal>
          <SessionCalendar
            events={sessionEvents}
            serviceSlug={service.slug}
            title={`${service.name} - kalenteri`}
            emptyMessage={`Ei aikataulutettuja sessioita palvelulle ${service.name} juuri nyt. Uudet ajat lisätään tänne heti, kun ne varmistuvat.`}
          />
        </Reveal>
      </div>
    </section>
  </article>
</BaseLayout>
